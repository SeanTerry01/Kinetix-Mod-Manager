<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="K4os.Compression.LZ4" Version="1.3.8" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <!-- The core used to be listed here file by file - 50 <Compile Include> paths reaching into the
       WinForms app, kept in step by hand so the tests would not drag in WebView2, NAudio and Tolk.
       That list has become the Kinetix.Core project, so one reference now says what fifty lines said,
       and a new core file is picked up without anyone having to remember to add it. -->
  <ItemGroup>
    <ProjectReference Include="..\Kinetix.Core\Kinetix.Core.csproj" />
  </ItemGroup>

  <!-- Real files.json bodies, recorded from the Nexus API rather than written by hand. The picking rules exist
       to cope with what these pages actually contain - a build named only in a file's description, a preloader
       that stopped saying "Part 2" in its name, a dozen archived files that cannot be downloaded - and none of
       that would be reproduced by a fixture invented to match the code. -->
  <ItemGroup>
    <None Include="fixtures\*.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- WitcherAccess's real Options-menu declaration, copied from an installed copy of the mod. Its separators,
         its hidden bookkeeping var and its three groups are what the reader has to cope with, and an invented
         file would only reproduce what the code already expects. -->
    <None Include="fixtures\*.xml" CopyToOutputDirectory="PreserveNewest" />
    <!-- A real solid LZMA2 7z, made with 7-Zip 23.01, holding a Stardew-shaped mod folder. It is here because
         7z support moved from shelling out to 7za.exe to reading the archive in-process, and the only way to
         know that actually works is to extract a genuine one - a hand-built container would only test the
         assumptions the code already makes. Solid on purpose: it is the case that used to be slow enough to
         look like a hang. -->
    <None Include="fixtures\*.7z" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
