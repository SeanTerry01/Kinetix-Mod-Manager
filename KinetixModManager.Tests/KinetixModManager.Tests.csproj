<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="K4os.Compression.LZ4" Version="1.3.8" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <!-- Compile the self-contained FOMOD logic directly instead of referencing the WinForms app.
       These four files depend only on the BCL and System.Xml.Linq, so the test project pulls in
       none of the app's heavy runtime (WebView2, NAudio, Tolk) - keeping the build tiny. -->
  <ItemGroup>
    <Compile Include="..\KinetixModManager\FomodConfig.cs" />
    <Compile Include="..\KinetixModManager\FomodParser.cs" />
    <Compile Include="..\KinetixModManager\FomodConditionEvaluator.cs" />
    <Compile Include="..\KinetixModManager\FomodInstaller.cs" />
    <!-- Self-contained mod-health checks (depend only on GameMod metadata, no app runtime). -->
    <Compile Include="..\KinetixModManager\GameMod.cs" />
    <Compile Include="..\KinetixModManager\ModDependency.cs" />
    <Compile Include="..\KinetixModManager\ModHealth.cs" />
    <!-- Self-contained Steam library detection (depends only on the BCL). -->
    <Compile Include="..\KinetixModManager\SteamLibraryLocator.cs" />
    <!-- Self-contained GOG game detection, for when GOG's registry entry is missing or stale (BCL only). -->
    <Compile Include="..\KinetixModManager\GogLibraryLocator.cs" />
    <!-- Self-contained root-folder-mod layout classifier (depends only on the BCL). -->
    <Compile Include="..\KinetixModManager\BethesdaLayout.cs" />
    <!-- Self-contained INI parse/edit model behind the accessible INI editor (depends only on the BCL). -->
    <Compile Include="..\KinetixModManager\IniDocument.cs" />
    <!-- Self-contained Bethesda save-file parser (depends on the BCL + K4os LZ4, no app runtime). -->
    <Compile Include="..\KinetixModManager\SaveGame.cs" />
    <!-- Self-contained version handling for the smapi.io update check (depends only on the BCL). -->
    <Compile Include="..\KinetixModManager\SmapiVersion.cs" />
    <!-- Self-contained "can this mod be update-checked?" rules (BCL + GameMod metadata). -->
    <Compile Include="..\KinetixModManager\UpdateCoverage.cs" />
    <!-- Self-contained manifest/download-name parsing (BCL + Newtonsoft). -->
    <Compile Include="..\KinetixModManager\ModManifest.cs" />
    <!-- Self-contained "is this Nexus search result the same mod?" rules (BCL + GameMod metadata). -->
    <Compile Include="..\KinetixModManager\ModNameMatch.cs" />
    <!-- Self-contained registry of the supported games and their per-game constants (depends only on the BCL). -->
    <Compile Include="..\KinetixModManager\GameProfiles.cs" />
    <!-- Self-contained reader for what an nxm:// download link says it is for (depends only on the BCL). -->
    <Compile Include="..\KinetixModManager\NxmLink.cs" />
    <!-- Self-contained "what is this mod actually called?" rules for speech and folder names (BCL only). -->
    <Compile Include="..\KinetixModManager\ModDisplayName.cs" />
    <!-- Self-contained "what should this mod folder be called?" rules (BCL + ModDisplayName + Witcher3Layout). -->
    <Compile Include="..\KinetixModManager\ModFolderTidy.cs" />
    <!-- Self-contained BepInEx plugin identity reader (BCL only; System.Reflection.Metadata ships in-box). -->
    <Compile Include="..\KinetixModManager\BepInExPlugin.cs" />
    <!-- Self-contained "where does a mod folder live when enabled/disabled?" rules (BCL + GameProfiles). -->
    <Compile Include="..\KinetixModManager\ModEnableState.cs" />
    <!-- Self-contained reader for a game's exported keyboard bindings (BCL + Newtonsoft + GameProfiles). -->
    <Compile Include="..\KinetixModManager\GameKeybindExport.cs" />
    <!-- Self-contained reader for a Content Patcher pack's configurable settings (BCL + Newtonsoft). -->
    <Compile Include="..\KinetixModManager\ContentPatcherConfig.cs" />
    <!-- Self-contained reader for what a BepInEx config file says about its own settings (BCL only). -->
    <Compile Include="..\KinetixModManager\BepInExConfigSchema.cs" />
    <!-- Self-contained reader for a mod's Mod Configuration Menu (BCL + Newtonsoft + IniDocument). -->
    <Compile Include="..\KinetixModManager\McmConfigSchema.cs" />
    <!-- Self-contained reader for an ordinary Stardew mod's config.json + i18n labels (BCL + Newtonsoft). -->
    <Compile Include="..\KinetixModManager\StardewModConfig.cs" />
    <!-- Self-contained reader for The Witcher 3's own input.settings keybindings (BCL + IniDocument). -->
    <Compile Include="..\KinetixModManager\Witcher3InputSettings.cs" />
    <!-- Self-contained reader/writer for The Witcher 3's own mods.settings (BCL + IniDocument). -->
    <Compile Include="..\KinetixModManager\Witcher3ModSettings.cs" />
    <!-- Self-contained "how do you read 2,800 bindings aloud?" grouping (BCL + Witcher3InputSettings). -->
    <Compile Include="..\KinetixModManager\Witcher3Controls.cs" />
    <!-- Self-contained reader for a Witcher 3 mod's Options-menu declaration (BCL + System.Xml.Linq + McmConfigSchema). -->
    <Compile Include="..\KinetixModManager\Witcher3UserConfig.cs" />
    <!-- Self-contained "which file on this mod page do we actually need?" rules (BCL + Newtonsoft + GameProfiles). -->
    <Compile Include="..\KinetixModManager\ModPartRules.cs" />
    <!-- Self-contained "which folders in this archive are Witcher 3 mods?" rules (depends only on the BCL). -->
    <Compile Include="..\KinetixModManager\Witcher3Layout.cs" />
    <!-- Minecraft: where .minecraft lives, and reading a mod's fabric.mod.json out of its jar (BCL + Json.NET).
         GameProfiles.cs references it for the Minecraft entry's default folder, so it has to come along. -->
    <Compile Include="..\KinetixModManager\MinecraftLayout.cs" />
    <!-- Which Minecraft accessibility mod the suite installs, and what each one drags in behind it (BCL only). -->
    <Compile Include="..\KinetixModManager\MinecraftSuite.cs" />
    <!-- Installs Fabric without its exe: reads meta.fabricmc.net and writes the launcher's own profile list.
         The naming, the profile upsert and the Quick Play repoint are pure and tested here (BCL + Json.NET). -->
    <Compile Include="..\KinetixModManager\FabricInstaller.cs" />
    <!-- Self-contained Visual C++ runtime consistency check, plus the Wine detection it defers to (BCL only). -->
    <Compile Include="..\KinetixModManager\VcRuntimeCheck.cs" />
    <Compile Include="..\KinetixModManager\PlatformInfo.cs" />
    <!-- Self-contained "which script extender is installed and will it load?" reader (BCL + GameProfiles). -->
    <Compile Include="..\KinetixModManager\ScriptExtenderInfo.cs" />
    <!-- Self-contained Markdown outline + phrase search behind the F1/F2/F3 document viewers (BCL only). -->
    <Compile Include="..\KinetixModManager\DocOutline.cs" />
    <!-- Self-contained "why did the DLL plugins not load?" reader: Address Library + SKSE/F4SE log (BCL). -->
    <Compile Include="..\KinetixModManager\ScriptExtenderPlugins.cs" />
    <!-- Self-contained store behind the curator's list of mods worth suggesting (BCL + Newtonsoft + GameProfiles). -->
    <Compile Include="..\KinetixModManager\SuggestedMod.cs" />
    <!-- Self-contained read/write/merge rules for a shared suggestions list (BCL + Newtonsoft + SuggestedMod). -->
    <Compile Include="..\KinetixModManager\SuggestionList.cs" />
    <!-- Self-contained "is this a real key press or auto-repeat?" rule (no BCL dependency at all). -->
    <Compile Include="..\KinetixModManager\KeyRepeatFilter.cs" />
    <!-- Self-contained "where am I in a list divided by headings?" counting (BCL only). -->
    <Compile Include="..\KinetixModManager\ListSections.cs" />
    <!-- The one diagnostic log everything writes to; BCL only, so its formatting is testable directly. -->
    <Compile Include="..\KinetixModManager\DiagnosticLog.cs" />
  </ItemGroup>

  <!-- Real files.json bodies, recorded from the Nexus API rather than written by hand. The picking rules exist
       to cope with what these pages actually contain - a build named only in a file's description, a preloader
       that stopped saying "Part 2" in its name, a dozen archived files that cannot be downloaded - and none of
       that would be reproduced by a fixture invented to match the code. -->
  <ItemGroup>
    <None Include="fixtures\*.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- WitcherAccess's real Options-menu declaration, copied from an installed copy of the mod. Its separators,
         its hidden bookkeeping var and its three groups are what the reader has to cope with, and an invented
         file would only reproduce what the code already expects. -->
    <None Include="fixtures\*.xml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
